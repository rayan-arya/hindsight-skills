{
  "name": "hindsight-skills",
  "version": "0.1.0",
  "private": true,
  "description": "The five Hindsight GBrain skills and an Express HTTP server. Built for the YC GStack x GBrain hackathon.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "qa": "npm run typecheck && npm run lint",
    "extract-takes:check": "tsx --env-file-if-exists=.env skills/extract-takes/check-gold-standard.ts",
    "resolve-outcomes:audit": "tsx --env-file-if-exists=.env skills/resolve-outcomes/audit-matching.ts",
    "hindsight-profile:check": "tsx --env-file-if-exists=.env skills/hindsight-profile/check-profile.ts",
    "calibrated-advise:check": "tsx --env-file-if-exists=.env skills/calibrated-advise/check-advise.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@hindsight/types": "file:../hindsight-types",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "eslint": "^10.4.0",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  }
}
